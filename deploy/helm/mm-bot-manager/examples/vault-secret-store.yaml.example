# Operator-managed infrastructure, not a Helm template. Edit and apply separately.
# Install matching ESO CRDs first; change apiVersion if they serve v1beta1 only.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: vault-mm-bot-manager-reader
  namespace: mm-bot-manager
automountServiceAccountToken: false
---
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata:
  name: vault-mm-bot-manager
  namespace: mm-bot-manager
spec:
  provider:
    vault:
      server: https://vault.example.com
      path: secret
      version: v2
      # For a private CA, configure a matching ConfigMap in this namespace:
      # caProvider:
      #   type: ConfigMap
      #   name: vault-ca
      #   key: ca.crt
      auth:
        kubernetes:
          mountPath: kubernetes
          role: mm-bot-manager-reader
          serviceAccountRef:
            name: vault-mm-bot-manager-reader
            audiences: [vault]
