# Local Bash configuration, loaded from the repository root. No secrets here.
# Choose the profile ONCE; check/apply/upgrade always reload this file.
chart="deploy/helm/mm-bot-manager"
# Replace CHANGE_ME_PROFILE with values-internal-longhorn, values-internal-local-path,
# values-harbor or values-external (without the .yaml suffix).
profile="$chart/examples/CHANGE_ME_PROFILE.yaml"
site=".local/kubernetes/values-site.yaml"
# Copy the exact output of: kubectl config current-context
context="CHANGE_ME_KUBE_CONTEXT"
