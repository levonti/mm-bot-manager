{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mm-bot-manager Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "imagePullSecrets",
    "nameOverride",
    "fullnameOverride",
    "app",
    "externalSecrets",
    "mattermost",
    "logLevel",
    "health",
    "probes",
    "serviceAccount",
    "podAnnotations",
    "podLabels",
    "podSecurityContext",
    "containerSecurityContext",
    "resources",
    "nodeSelector",
    "tolerations",
    "affinity",
    "terminationGracePeriodSeconds",
    "database"
  ],
  "properties": {
    "image": { "$ref": "#/definitions/image" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "$ref": "#/definitions/nonEmptyString" } }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": { "existingSecret": { "$ref": "#/definitions/nonEmptyString" } }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "apiVersion",
        "refreshInterval",
        "secretStoreRef",
        "app",
        "database"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiVersion": {
          "enum": [
            "external-secrets.io/v1",
            "external-secrets.io/v1beta1"
          ]
        },
        "refreshInterval": {
          "type": "string",
          "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:h|m|s|ms))+$",
          "not": {
            "pattern": "^(?:0+(?:\\.0+)?(?:h|m|s|ms))+$"
          }
        },
        "secretStoreRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "kind"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "SecretStore",
                "ClusterSecretStore"
              ]
            }
          }
        },
        "app": {
          "$ref": "#/definitions/externalSecretTarget"
        },
        "database": {
          "$ref": "#/definitions/externalSecretTarget"
        }
      }
    },
    "mattermost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "approvers", "verifySSL"],
      "properties": {
        "url": { "type": "string", "format": "uri", "minLength": 1 },
        "approvers": { "type": "string" },
        "catalogViewers": { "type": "string" },
        "feedbackHandlers": { "type": "string" },
        "defaultLanguage": { "enum": ["en", "ru"] },
        "displayTimezone": { "type": "string", "minLength": 1 },
        "verifySSL": { "type": "boolean" },
        "caBundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingConfigMap", "key"],
          "properties": {
            "existingConfigMap": { "type": "string" },
            "key": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
          }
        }
      }
    },
    "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "$ref": "#/definitions/nonEmptyString" },
        "port": { "$ref": "#/definitions/port" }
      }
    },
    "probes": { "$ref": "#/definitions/probes" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "propertyNames": {
        "not": { "enum": ["app.kubernetes.io/name", "app.kubernetes.io/instance", "app.kubernetes.io/component"] }
      }
    },
    "podSecurityContext": { "$ref": "#/definitions/podSecurityContext" },
    "containerSecurityContext": { "$ref": "#/definitions/containerSecurityContext" },
    "resources": { "$ref": "#/definitions/resources" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": {
      "type": "array",
      "items": { "$ref": "#/definitions/toleration" }
    },
    "affinity": { "$ref": "#/definitions/affinity" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "external", "internal"],
      "properties": {
        "mode": { "enum": ["external", "internal"] },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" }
          }
        },
        "internal": { "$ref": "#/definitions/internalDatabase" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "external" } } },
          "then": {
            "required": ["external"],
            "properties": {
              "external": {
                "required": ["existingSecret"],
                "properties": {
                  "existingSecret": { "$ref": "#/definitions/nonEmptyString" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "internal" } } },
          "then": {
            "required": ["internal"],
            "properties": {
              "internal": {
                "required": ["image", "auth", "storage", "backup"],
                "properties": {
                  "auth": {
                    "required": ["existingSecret"],
                    "properties": {
                      "existingSecret": { "$ref": "#/definitions/nonEmptyString" }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "externalSecrets": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "externalSecrets": {
            "properties": {
              "secretStoreRef": {
                "properties": {
                  "name": {
                    "$ref": "#/definitions/nonEmptyString"
                  }
                }
              }
            },
            "anyOf": [
              {
                "properties": {
                  "app": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "database": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "externalSecrets": {
            "properties": {
              "enabled": {
                "const": true
              },
              "app": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "externalSecrets": {
            "properties": {
              "app": {
                "properties": {
                  "data": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "MM_TOKEN",
                      "MM_BOT_TOKEN"
                    ],
                    "properties": {
                      "MM_TOKEN": {
                        "$ref": "#/definitions/externalSecretRemoteRef"
                      },
                      "MM_BOT_TOKEN": {
                        "$ref": "#/definitions/externalSecretRemoteRef"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "externalSecrets": {
            "properties": {
              "enabled": {
                "const": true
              },
              "database": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          },
          "database": {
            "properties": {
              "mode": {
                "const": "external"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "externalSecrets": {
            "properties": {
              "database": {
                "properties": {
                  "data": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "DB_URL"
                    ],
                    "properties": {
                      "DB_URL": {
                        "$ref": "#/definitions/externalSecretRemoteRef"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "externalSecrets": {
            "properties": {
              "enabled": {
                "const": true
              },
              "database": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          },
          "database": {
            "properties": {
              "mode": {
                "const": "internal"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "externalSecrets": {
            "properties": {
              "database": {
                "properties": {
                  "data": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "POSTGRES_USER",
                      "POSTGRES_PASSWORD",
                      "POSTGRES_DB"
                    ],
                    "properties": {
                      "POSTGRES_USER": {
                        "$ref": "#/definitions/externalSecretRemoteRef"
                      },
                      "POSTGRES_PASSWORD": {
                        "$ref": "#/definitions/externalSecretRemoteRef"
                      },
                      "POSTGRES_DB": {
                        "$ref": "#/definitions/externalSecretRemoteRef"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "externalSecretRemoteRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "property": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "version": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "externalSecretTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "data"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/externalSecretRemoteRef"
          }
        }
      }
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "positiveQuantity": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?)(?:Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k|m)?$"
    },
    "storageQuantity": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?)(?:Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^$|^sha256:[0-9a-f]{64}$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/definitions/positiveQuantity" }
      }
    },
    "toleration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "operator": { "enum": ["Exists", "Equal"] },
        "value": { "type": "string" },
        "effect": { "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"] },
        "tolerationSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "labelSelectorRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator"],
      "properties": {
        "key": { "$ref": "#/definitions/nonEmptyString" },
        "operator": { "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
        "values": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": { "$ref": "#/definitions/stringMap" },
        "matchExpressions": {
          "type": "array",
          "items": { "$ref": "#/definitions/labelSelectorRequirement" }
        }
      }
    },
    "nodeSelectorRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator"],
      "properties": {
        "key": { "$ref": "#/definitions/nonEmptyString" },
        "operator": { "enum": ["In", "NotIn", "Exists", "DoesNotExist", "Gt", "Lt"] },
        "values": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "nodeSelectorTerm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchExpressions": {
          "type": "array",
          "items": { "$ref": "#/definitions/nodeSelectorRequirement" }
        },
        "matchFields": {
          "type": "array",
          "items": { "$ref": "#/definitions/nodeSelectorRequirement" }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeSelectorTerms"],
      "properties": {
        "nodeSelectorTerms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/nodeSelectorTerm" }
        }
      }
    },
    "preferredSchedulingTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "preference"],
      "properties": {
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "preference": { "$ref": "#/definitions/nodeSelectorTerm" }
      }
    },
    "nodeAffinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredDuringSchedulingIgnoredDuringExecution": {
          "$ref": "#/definitions/nodeSelector"
        },
        "preferredDuringSchedulingIgnoredDuringExecution": {
          "type": "array",
          "items": { "$ref": "#/definitions/preferredSchedulingTerm" }
        }
      }
    },
    "podAffinityTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topologyKey"],
      "properties": {
        "labelSelector": { "$ref": "#/definitions/labelSelector" },
        "namespaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "topologyKey": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "weightedPodAffinityTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "podAffinityTerm"],
      "properties": {
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "podAffinityTerm": { "$ref": "#/definitions/podAffinityTerm" }
      }
    },
    "podAffinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredDuringSchedulingIgnoredDuringExecution": {
          "type": "array",
          "items": { "$ref": "#/definitions/podAffinityTerm" }
        },
        "preferredDuringSchedulingIgnoredDuringExecution": {
          "type": "array",
          "items": { "$ref": "#/definitions/weightedPodAffinityTerm" }
        }
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeAffinity": { "$ref": "#/definitions/nodeAffinity" },
        "podAffinity": { "$ref": "#/definitions/podAffinity" },
        "podAntiAffinity": { "$ref": "#/definitions/podAffinity" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "$ref": "#/definitions/nonEmptyString" },
        "tag": { "type": "string" },
        "digest": { "$ref": "#/definitions/digest" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 0 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drop"],
          "properties": {
            "drop": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "databaseAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageClass", "accessModes", "size"],
      "properties": {
        "storageClass": { "$ref": "#/definitions/nonEmptyString" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"]
          }
        },
        "size": { "$ref": "#/definitions/storageQuantity" }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "schedule",
        "retentionDays",
        "successfulJobsHistoryLimit",
        "failedJobsHistoryLimit",
        "storageClass",
        "accessModes",
        "size",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "$ref": "#/definitions/nonEmptyString" },
        "retentionDays": { "type": "integer", "minimum": 1 },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "storageClass": { "$ref": "#/definitions/nonEmptyString" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"]
          }
        },
        "size": { "$ref": "#/definitions/storageQuantity" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "file"],
      "allOf": [{
        "if": { "properties": { "enabled": { "const": true } } },
        "then": { "properties": { "file": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.dump$" } } }
      }],
      "properties": {
        "enabled": { "type": "boolean" },
        "file": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    },
    "internalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "auth",
        "service",
        "storage",
        "podSecurityContext",
        "containerSecurityContext",
        "resources",
        "probes",
        "backup",
        "restore"
      ],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "auth": { "$ref": "#/definitions/databaseAuth" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": { "port": { "$ref": "#/definitions/port" } }
        },
        "storage": { "$ref": "#/definitions/storage" },
        "podSecurityContext": { "$ref": "#/definitions/podSecurityContext" },
        "containerSecurityContext": { "$ref": "#/definitions/containerSecurityContext" },
        "resources": { "$ref": "#/definitions/resources" },
        "probes": { "$ref": "#/definitions/probes" },
        "backup": { "$ref": "#/definitions/backup" },
        "restore": { "$ref": "#/definitions/restore" },
        "verification": { "$ref": "#/definitions/restore" },
        "inspect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    }
  }
}
