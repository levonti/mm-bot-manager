# Base URL of the Mattermost server
MM_URL=https://mm.example.com

# Personal Access Token from a system_admin USER account (not a bot token).
# Used for bot management REST API calls (create, update, delete bots, manage tokens).
# The account must have: create_bot, read_bots, manage_others_bots,
# create_user_access_token, read_user_access_token, revoke_user_access_token,
# edit_other_users. All included in the default system_admin role.
MM_TOKEN=replace-me-admin-pat

# Personal Access Token of the manager BOT account.
# Used for the WebSocket connection and for posting replies (so messages appear
# from the bot, not the admin user). Create via Integrations → Bot Accounts,
# then generate a token for that bot account.
MM_BOT_TOKEN=replace-me-bot-pat

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL credentials used by both the postgres service and the bot's DB_URL.
# Change POSTGRES_PASSWORD to a strong random value in any non-local environment.
POSTGRES_USER=mm_bot
POSTGRES_DB=mm_bot_manager
POSTGRES_PASSWORD=secret

# DB_URL is constructed automatically in docker-compose.yml from the variables above.
# Override here only if you point at an external PostgreSQL instance.
# DB_URL=postgresql://mm_bot:secret@postgres/mm_bot_manager

# DB_PATH is only used when DB_URL is unset (SQLite fallback for local dev without compose).
# DB_PATH=/data/mm-bot-manager.sqlite3

# ── Logging & TLS ─────────────────────────────────────────────────────────────
# INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO

# Set to false to skip TLS certificate verification (useful for self-signed certs).
# Never disable in production.
MM_VERIFY_SSL=true

# ── Approval gate ─────────────────────────────────────────────────────────────
# Comma-separated Mattermost usernames of users who can approve bot creation requests.
# If empty or unset, bot creation is immediate (no approval step).
# MM_APPROVERS=alice,bob
